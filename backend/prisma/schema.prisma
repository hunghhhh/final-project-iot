// Prisma schema — IoT Motor Monitoring System
// Docs: https://pris.ly/d/prisma-schema
// Note: Using SQLite for dev (no enum support → using String with validation in app layer)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Device ────────────────────────────────────────────────────────────────
// Represents an industrial motor unit being monitored
model Device {
  id          String    @id @default(cuid())
  name        String    // e.g. "Induction Motor Line A-01"
  type        String    @default("induction_motor")
  location    String    // e.g. "Factory Floor B, Zone 3"
  ratedPower  Float?    // Rated power in kW
  ratedRpm    Float?    // Rated RPM (e.g. 1450)
  // status: "ACTIVE" | "MAINTENANCE" | "OFFLINE" | "FAULT"
  status      String    @default("ACTIVE")
  readings    SensorReading[]
  alerts      Alert[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("devices")
}

// ─── SensorReading ─────────────────────────────────────────────────────────
// One time-series data point emitted by the IoT Simulator every 500ms
model SensorReading {
  id            String   @id @default(cuid())
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // Motor sensor metrics (matches IoT Data Contract)
  temperature   Float    // °C — stator winding temperature
  vibrationX    Float    // mm/s — vibration X-axis
  vibrationY    Float    // mm/s — vibration Y-axis
  vibrationZ    Float    // mm/s — vibration Z-axis
  current       Float    // Ampere — phase current draw
  rpm           Float    // Rotations per minute

  // Fault injection metadata (set by Simulator — Ground Truth labels)
  faultInjected Boolean  @default(false)
  // faultType: "spike" | "drift" | "flatline" | "contextual" | null
  faultType     String?

  timestamp     DateTime @default(now())

  @@index([deviceId, timestamp])
  @@map("sensor_readings")
}

// ─── Alert ─────────────────────────────────────────────────────────────────
// Anomaly alert generated by an AI model
model Alert {
  id            String   @id @default(cuid())
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // modelName: "isolation_forest" | "lstm_autoencoder"
  modelName     String
  anomalyScore  Float    // 0.0 – 1.0
  // severity: "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  severity      String
  faultType     String?  // Predicted fault type
  message       String

  acknowledged  Boolean  @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([deviceId, createdAt])
  @@map("alerts")
}

// ─── SecurityEvent ─────────────────────────────────────────────────────────
// Web security events detected by AI-powered WAF middleware
model SecurityEvent {
  id        String   @id @default(cuid())
  ip        String
  method    String   // HTTP method: GET | POST | PUT | DELETE
  endpoint  String   // Request path
  userAgent String?
  payload   String?  // Suspicious payload content (truncated to 500 chars)
  riskScore Float    // 0.0 – 1.0 from AI model
  // threat: "ddos" | "brute_force" | "sql_injection" | "xss" | "scan"
  threat    String
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@map("security_events")
}
